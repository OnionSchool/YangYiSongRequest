# syntax=docker/dockerfile:1

# Shared native-dependency builder. Publish a multi-architecture image with
# .github/workflows/docker-build-base.yml before using this in the app build.
FROM oven/bun:1.3.13-alpine

# Alpine does not provide a standalone node-gyp package. better-sqlite3 needs
# node-gyp plus these native build tools when Bun installs dependencies.
RUN apk add --no-cache python3 make g++ nodejs npm \
  && npm install --global node-gyp
