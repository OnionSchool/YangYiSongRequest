# 生产环境必须使用 HTTPS，并将此文件权限限制为仅部署账户可读。
NODE_ENV=production
PORT=3000
# 可选测试或隔离实例数据库路径；未设置时使用 data/server.sqlite。
# DATABASE_URL=data/server.sqlite
# 首次生产启动必填：用户名仅可使用字母、数字、下划线和连字符，密码至少 12 位。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-to-a-long-random-password

# 仅开发环境可用，生产环境始终忽略。
# DEBUG_MODE=true

# 仅在反向代理 IP 位于此逗号分隔列表时才信任转发地址头。
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# 在超级管理员后台的“音源配置”页面添加外部 Meting API。
# 可添加多个 API，并为每个 API 配置名称、Base URL、支持的平台及优先级。
# 参考 https://github.com/metowolf/Meting 部署对应的 Meting API 服务。

# 可选 S3 兼容音频缓存，未设置时由可信音源实时代理。
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=campus-radio-audio
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# 可选 SMTP 邮件服务，用于管理员邮箱绑定验证。未配置时邮箱绑定功能不可用。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=广播台 <noreply@example.com>

# 下载地址在超级管理员后台的“音源状态”页面维护；未配置时下载功能保持关闭。
# 单曲缓存最大大小（字节），默认 31457280（30 MiB）。
# MUSIC_DOWNLOAD_MAX_BYTES=31457280
