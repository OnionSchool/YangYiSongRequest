# Point Song Request - Environment Configuration

# Node environment
NODE_ENV=production

# Server port
PORT=3000

# Database (SQLite by default)
# Leave empty to use SQLite at ./data/server.sqlite
DATABASE_URL=

# Optional: PostgreSQL configuration
# Uncomment to use PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/yangyi_songrequest

# Debug mode: skip admin login (auto-authenticated as SUPER admin)
# WARNING: Never enable in production!
# DEBUG_MODE=true
